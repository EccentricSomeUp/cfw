{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "debug",
            "displayName": "Debug",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CFW_ENABLE_WERROR": "ON",
                "CFW_ENABLE_SANITIZERS": "OFF"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CFW_ENABLE_WERROR": "ON",
                "CFW_ENABLE_SANITIZERS": "OFF"
            }
        },
        {
            "name": "sanitizers",
            "displayName": "ASan + UBSan",
            "binaryDir": "${sourceDir}/build/sanitizers",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CFW_ENABLE_WERROR": "ON",
                "CFW_ENABLE_SANITIZERS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "sanitizers",
            "configurePreset": "sanitizers"
        }
    ],
    "testPresets": [
        {
            "name": "debug",
            "configurePreset": "debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "release",
            "configurePreset": "release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "sanitizers",
            "configurePreset": "sanitizers",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
