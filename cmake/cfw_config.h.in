#ifndef CFW_CONFIG_H
#define CFW_CONFIG_H

#define CFW_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define CFW_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define CFW_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define CFW_VERSION_STRING "@PROJECT_VERSION@"

#define CFW_ABI_VERSION @CFW_ABI_VERSION@

/* 1 when the optional OpenSSL-backed TLS module (ADR 0057) was
 * compiled in via CFW_ENABLE_TLS; 0 otherwise. */
#define CFW_HAVE_TLS @CFW_HAVE_TLS@

#endif /* CFW_CONFIG_H */
